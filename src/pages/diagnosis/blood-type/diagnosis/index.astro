</BaseLayout>

<script>
/**
 * 血液型サブタイプ診断 クライアントサイドロジック
 *
 * Step1: 血液型選択 → selectedBloodType を保持
 * Step2: 10問のリッカート質問を順次表示 → 回答収集
 * Step3: スコア計算 → 結果ページへリダイレクト
 *
 * LocalStorage:
 * - sn_blood_type: 選択した血液型
 * - sn_scores_bloodSubtype: 診断結果
 */

type BloodType = 'A' | 'B' | 'O' | 'AB';
type Big5Axis = 'E' | 'A' | 'N' | 'C';

interface QuestionData {
  id: number;
  text: string;
  axis: Big5Axis;
}

// 質問データ（サーバーサイドと同一）
const QUESTIONS: QuestionData[] = [
  { id: 1, text: '初対面の人と話すときも、自分から積極的に話しかける方だ', axis: 'E' },
  { id: 2, text: '細かいことが気になって、ちょっとしたミスや言葉のズレを引きずりやすい', axis: 'N' },
  { id: 3, text: '物事を始める前に、手順や段取りを考えてから動くことが多い', axis: 'C' },
  { id: 4, text: '誰かが困っていると、気づかないふりができず、つい助けてしまう', axis: 'A' },
  { id: 5, text: '複数の人がいる場の中心にいることが心地よく、会話が弾むと元気が出る', axis: 'E' },
  { id: 6, text: '気分の浮き沈みがあり、調子のよい日と悪い日の差が出やすい', axis: 'N' },
  { id: 7, text: '決めたことはきちんと守りたいと思い、自分への約束も大切にしている', axis: 'C' },
  { id: 8, text: '人との会話や交流がエネルギーの源になっており、一人より誰かといる方が楽しい', axis: 'E' },
  { id: 9, text: '意見が対立したとき、自分の主張より関係の調和を優先することが多い', axis: 'A' },
  { id: 10, text: '他人の評価や反応が気になって、言いたいことを言えないことがある', axis: 'N' },
];

const SCALE_LABELS = [
  { value: 1, label: '全く当てはまらない' },
  { value: 2, label: 'あまり当てはまらない' },
  { value: 3, label: 'どちらともいえない' },
  { value: 4, label: 'やや当てはまる' },
  { value: 5, label: 'とても当てはまる' },
];

interface AxisScores { E: number; A: number; N: number; C: number; }

function calculateAxisScores(answers: Record<number, number>): AxisScores {
  const raw: AxisScores = { E: 0, A: 0, N: 0, C: 0 };
  const counts: AxisScores = { E: 0, A: 0, N: 0, C: 0 };

  for (const q of QUESTIONS) {
    const val = answers[q.id];
    if (val === undefined) continue;
    raw[q.axis] += val;
    counts[q.axis] += 1;
  }

  const normalized: AxisScores = { E: 50, A: 50, N: 50, C: 50 };
  const axes: Big5Axis[] = ['E', 'A', 'N', 'C'];
  for (const axis of axes) {
    const count = counts[axis];
    if (count === 0) continue;
    const maxScore = count * 5;
    const minScore = count * 1;
    normalized[axis] = Math.round(((raw[axis] - minScore) / (maxScore - minScore)) * 100);
  }
  return normalized;
}

function determineSubtype(bloodType: BloodType, scores: AxisScores): string {
  const stability = 100 - scores.N;
  switch (bloodType) {
    case 'A':
      if (scores.E < 45 && scores.N >= 55) return 'A-inner';
      if (scores.E >= 58) return 'A-active';
      return 'A-typical';
    case 'B':
      if (scores.E < 45 && scores.A < 50) return 'B-focused';
      if (scores.E >= 62 && scores.A >= 55) return 'B-social';
      return 'B-typical';
    case 'O':
      if (scores.A >= 68) return 'O-gentle';
      if (scores.E < 60 && scores.C >= 60) return 'O-explorer';
      return 'O-typical';
    case 'AB':
      if (scores.N >= 62) return 'AB-empathy';
      if (stability >= 62 && scores.C >= 65) return 'AB-analyst';
      return 'AB-typical';
    default:
      return 'A-typical';
  }
}

// ---- State ----
let selectedBloodType: BloodType | null = null;
let currentQuestionIndex = 0;
const answers: Record<number, number> = {};

// ---- DOM refs ----
const step1Panel = document.getElementById('bst-step1') as HTMLDivElement | null;
const step2Panel = document.getElementById('bst-step2') as HTMLDivElement | null;
const questionArea = document.getElementById('bst-question-area') as HTMLDivElement | null;

// ---- Step1: 血液型選択 ----
const bloodBtns = document.querySelectorAll<HTMLButtonElement>('.bst-blood-btn');

bloodBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    selectedBloodType = btn.dataset.bloodtype as BloodType;

    // active状態の視覚フィードバック
    bloodBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');

    // localStorage に血液型を保存
    try {
      localStorage.setItem('sn_blood_type', JSON.stringify({ type: selectedBloodType }));
    } catch { /* ignore */ }

    // Step2へ遷移（短いディレイでUX向上）
    setTimeout(() => {
      step1Panel?.setAttribute('aria-hidden', 'true');
      if (step1Panel) step1Panel.style.display = 'none';
      step2Panel?.removeAttribute('hidden');
      step2Panel?.removeAttribute('aria-hidden');
      currentQuestionIndex = 0;
      renderQuestion(0);
    }, 300);
  });
});

// ---- Step2: 質問レンダリング ----
function renderQuestion(index: number): void {
  if (!questionArea) return;
  const q = QUESTIONS[index];
  if (!q) return;

  const total = QUESTIONS.length;
  const progressPct = Math.round((index / total) * 100);

  questionArea.innerHTML = `
    <div class="bst-qflow">
      <div class="bst-qflow-header">
        <span class="bst-qflow-progress-label" aria-live="polite">
          質問 ${index + 1} / ${total}
        </span>
        <div class="bst-qflow-progress-bar" role="progressbar" aria-valuenow="${progressPct}" aria-valuemin="0" aria-valuemax="100">
          <div class="bst-qflow-progress-fill" style="width: ${progressPct}%"></div>
        </div>
      </div>
      <div class="bst-qflow-body">
        <p class="bst-qflow-text">${q.text}</p>
        <div class="bst-qflow-scale" role="group" aria-label="回答を選んでください">
          ${SCALE_LABELS.map((sl) => `
            <button
              class="bst-scale-btn${answers[q.id] === sl.value ? ' bst-scale-btn--selected' : ''}"
              data-value="${sl.value}"
              type="button"
              aria-pressed="${answers[q.id] === sl.value ? 'true' : 'false'}"
            >
              <span class="bst-scale-num">${sl.value}</span>
              <span class="bst-scale-label">${sl.label}</span>
            </button>
          `).join('')}
        </div>
      </div>
      ${index > 0 ? `
        <div class="bst-qflow-nav">
          <button class="bst-qflow-back" type="button" id="bst-back-btn">
            ← 戻る
          </button>
        </div>
      ` : ''}
    </div>
  `;

  // スケールボタンのクリックイベント
  const scaleBtns = questionArea.querySelectorAll<HTMLButtonElement>('.bst-scale-btn');
  scaleBtns.forEach((sb) => {
    sb.addEventListener('click', () => {
      const val = Number(sb.dataset.value);
      answers[q.id] = val;

      // アニメーション後に次の質問へ
      setTimeout(() => {
        if (index + 1 < total) {
          currentQuestionIndex = index + 1;
          renderQuestion(currentQuestionIndex);
        } else {
          finishDiagnosis();
        }
      }, 250);
    });
  });

  // 戻るボタン
  const backBtn = document.getElementById('bst-back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      currentQuestionIndex = index - 1;
      renderQuestion(currentQuestionIndex);
    });
  }
}

// ---- 診断完了 ----
function finishDiagnosis(): void {
  if (!selectedBloodType || !questionArea) return;

  const axisScores = calculateAxisScores(answers);
  const subtypeId = determineSubtype(selectedBloodType, axisScores);

  // LocalStorageに保存
  try {
    localStorage.setItem('sn_scores_bloodSubtype', JSON.stringify({
      bloodType: selectedBloodType,
      subtypeId,
      axisScores,
      emotionalStability: 100 - axisScores.N,
      savedAt: new Date().toISOString(),
    }));
  } catch { /* ignore */ }

  // ローディング表示
  questionArea.innerHTML = `
    <div class="bst-loading" aria-live="polite">
      <p class="bst-loading-text">結果を計算中...</p>
    </div>
  `;

  // 結果ページへリダイレクト
  setTimeout(() => {
    window.location.href = `/diagnosis/blood-type/diagnosis/result/${subtypeId}/`;
  }, 600);
}
</script>

