---
/**
 * 血液型サブタイプ診断 フローページ
 * URL: /diagnosis/blood-type/diagnosis/
 *
 * フロー:
 * Step 1: 血液型を選択（A/B/O/AB の4択）
 * Step 2: 10問のリッカート質問（DiagnosisFlow コンポーネント）
 * Step 3: 結果ページへ遷移 /diagnosis/blood-type/diagnosis/result/{typeId}/
 *
 * 学術根拠:
 * - 古川竹二 (1927) 血液型による気質の研究
 * - 能見正比古 (1971) 血液型でわかる相性（典型・変則・中間の概念）
 * - McCrae RR, Costa PT (1987) Big Five Personality Factors
 * - 日本心理学会 公式見解 (2014) 血液型と性格の無関連性
 *
 * YMYL回避: 医療・精神疾患言及ゼロ
 * 科学的限界の注記: 必須表示
 * ブラハラ警告: 必須表示
 *
 * 確認日: 2026-06-07
 */

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Container from '../../../../components/Container.astro';
import { meta } from '../../../../data/diagnoses/blood-subtype/meta';
import { questions } from '../../../../data/diagnoses/blood-subtype/questions';
import TldrBlock from '../../../../components/TldrBlock.astro';

const SITE_URL = 'https://shindan-navi.jp';
const PAGE_URL = `${SITE_URL}/diagnosis/blood-type/diagnosis/`;

// JSON-LD: WebApplication
const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${PAGE_URL}#webapp`,
  name: '血液型サブタイプ診断【無料・12タイプ・学術根拠付】',
  url: PAGE_URL,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  description: meta.description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'JPY',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: '診断ナビ',
    url: SITE_URL,
  },
  mentions: [
    {
      '@type': 'Thing',
      name: '血液型性格分類（古川竹二1927・能見正比古1971）',
      sameAs: 'https://ja.wikipedia.org/wiki/%E8%A1%80%E6%B6%B2%E5%9E%8B%E6%80%A7%E6%A0%BC%E5%88%86%E9%A1%9E',
    },
    {
      '@type': 'Thing',
      name: 'Big Five Personality Factors（McCrae & Costa 1987）',
      sameAs: 'https://en.wikipedia.org/wiki/Big_Five_personality_traits',
    },
  ],
};

// JSON-LD: FAQPage
const faqs = [
  {
    question: '血液型サブタイプ診断とは何ですか？',
    answer:
      '血液型（A/B/O/AB）ごとに3つのサブタイプを設定し、Big5の外向性・協調性・神経症傾向・誠実性に基づく10問の質問で「あなたはどのサブタイプか」を判定する自己理解ツールです。古川竹二（1927）・能見正比古（1971）の傾向区分概念をBig5心理学で再解釈したものです。血液型と性格の科学的相関は限定的であり（日本心理学会2014年）、自己理解の参考情報としてご活用ください。',
  },
  {
    question: '血液型サブタイプ診断に科学的根拠はありますか？',
    answer:
      '血液型による性格分類の原典は古川竹二（1927）の研究ですが、日本心理学会は2014年の公式見解で「血液型と性格の間に科学的に明確な統計的相関は認められない」としています（https://psych.or.jp/opinion/bl-personality/）。本診断は日本の文化的な血液型性格観を参考情報として提示するものであり、科学的測定ではありません。自己理解の話題としてお楽しみください。',
  },
  {
    question: '12タイプはどのように決まりますか？',
    answer:
      '4血液型×3サブタイプ＝12タイプです。まず血液型を選択し、次に10問の質問でBig5の外向性（E）・協調性（A）・神経症傾向（N）・誠実性（C）の4軸スコアを測定します。血液型ごとの判定ロジックで3サブタイプのうち最もスコアが高いものを判定します。',
  },
  {
    question: 'ブラッドハラスメント（ブラハラ）とは何ですか？',
    answer:
      '血液型を根拠にした差別・偏見・嫌がらせのことです。「B型だから自己中」「AB型だから変わっている」などのレッテルを貼ることは血液型ハラスメントにあたります。本診断は自己理解の参考情報であり、他者への決めつけや差別に使用しないでください。',
  },
  {
    question: '何分かかりますか？',
    answer:
      '血液型選択（約10秒）+ 10問の質問（約2分）で、合計約3分で完了します。登録不要・スマートフォンでも快適に受診できます。',
  },
];

const jsonLdFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE_URL}#faq`,
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

// JSON-LD: BreadcrumbList
const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: '診断一覧', item: `${SITE_URL}/diagnosis/` },
    { '@type': 'ListItem', position: 3, name: '血液型性格診断', item: `${SITE_URL}/diagnosis/blood-type/` },
    { '@type': 'ListItem', position: 4, name: '血液型サブタイプ診断', item: PAGE_URL },
  ],
};

const jsonLdAll = [jsonLdWebApp, jsonLdFAQ, jsonLdBreadcrumb];

// 血液型4択データ
const bloodTypeOptions = [
  { type: 'A', label: 'A型', color: '#e11d48', bg: '#fff1f4', emoji: '🩸' },
  { type: 'B', label: 'B型', color: '#1565c0', bg: '#eff6ff', emoji: '🩸' },
  { type: 'O', label: 'O型', color: '#e65100', bg: '#fff7ed', emoji: '🩸' },
  { type: 'AB', label: 'AB型', color: '#4a148c', bg: '#f5f3ff', emoji: '🩸' },
];

// 12タイプ一覧（概要用）
const subtypeOverview = [
  { group: 'A型', color: '#e11d48', types: ['典型A型（几帳面・慎重）', '行動A型（外向寄り）', '内省A型（内向・繊細）'] },
  { group: 'B型', color: '#1565c0', types: ['典型B型（自由・マイペース）', '協調B型（社交寄り）', '集中B型（職人気質）'] },
  { group: 'O型', color: '#e65100', types: ['典型O型（社交リーダー）', '温和O型（協調・支援）', '探究O型（独立・知的）'] },
  { group: 'AB型', color: '#4a148c', types: ['典型AB型（合理・独創）', '共感AB型（情緒寄り）', '分析AB型（論理寄り）'] },
];
---

