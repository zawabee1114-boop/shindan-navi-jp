---
/**
 * 血液型診断（自己理解）ハブページ
 * URL: /diagnosis/blood-type/
 * KW: 血液型診断 / 血液型 性格 / 血液型 特徴
 *
 * 位置づけ:
 *   「自己理解 → 相性活用」の順序を守るハブ。
 *   まず自分のタイプを知り（各タイプ詳細）、次に相性を活用（→ /diagnosis/blood-compat/）。
 *
 * 学術根拠:
 *   - 古川竹二 (1927) 「血液型による気質の研究」心理学研究 第2巻第4号
 *   - 能見正比古 (1971) 『血液型でわかる相性』青春出版社
 *   - Sakamoto A, Yamazaki K (2004) International Journal of Psychology 39(4)
 *     https://doi.org/10.1080/00207590344000248
 *   - 日本心理学会 公式見解「血液型と性格の無関連性」(2014)
 *     https://psych.or.jp/opinion/bl-personality/
 * 確認日: 2026-06-07
 *
 * SEO/AIO対応:
 * - JSON-LD: WebPage + BreadcrumbList
 * - @id連結: エンティティグラフ形成
 * - YMYL回避: 医療・精神疾患言及ゼロ
 * - disclaimer 必須表示
 * - 占い色NG・架空監修者NG
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import { typesDetail } from '../../../data/diagnoses/blood-compat/types-detail';
import { BLOOD_TYPES } from '../../../data/diagnoses/blood-compat/meta';

const SITE_URL = 'https://shindan-navi.jp';
const PAGE_URL = `${SITE_URL}/diagnosis/blood-type/`;
const UPDATED_AT = '2026-06-07';

// 4タイプのサマリー（ハブ用・学術根拠ベース）
const typeSummaries: Record<string, { color: string; bg: string; border: string; keyword: string; href: string }> = {
  A: {
    color: '#c0392b',
    bg: '#fff5f5',
    border: '#fca5a5',
    keyword: '几帳面・協調性・秩序重視',
    href: '/diagnosis/blood-type/a/',
  },
  B: {
    color: '#d35400',
    bg: '#fff7ed',
    border: '#fdba74',
    keyword: 'マイペース・自由・独創性',
    href: '/diagnosis/blood-type/b/',
  },
  O: {
    color: '#1a6b3a',
    bg: '#f0fdf4',
    border: '#86efac',
    keyword: 'リーダーシップ・大らか・行動力',
    href: '/diagnosis/blood-type/o/',
  },
  AB: {
    color: '#5b21b6',
    bg: '#f5f3ff',
    border: '#c4b5fd',
    keyword: '二面性・独自視点・柔軟',
    href: '/diagnosis/blood-type/ab/',
  },
};

// タイプ表示ラベル
const typeLabels: Record<string, string> = { A: 'A型', B: 'B型', O: 'O型', AB: 'AB型' };

// JSON-LD: WebPage
const jsonLdWebPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${PAGE_URL}#webpage`,
  url: PAGE_URL,
  name: '血液型診断【A・B・O・AB型 性格傾向】｜診断ナビ',
  description:
    '血液型（A型・B型・O型・AB型）の性格傾向・強み・仕事・恋愛スタイルを解説する自己理解ハブ。日本の文化的分類として古川竹二（1927）・能見正比古（1971）の研究をベースに整理。相性活用は派生ページから。',
  datePublished: '2026-06-07',
  dateModified: UPDATED_AT,
  inLanguage: 'ja',
  author: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: '診断ナビ',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
  },
};

// JSON-LD: BreadcrumbList
const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${PAGE_URL}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: '診断一覧', item: `${SITE_URL}/diagnosis/` },
    { '@type': 'ListItem', position: 3, name: '血液型診断', item: PAGE_URL },
  ],
};

const jsonLdAll = [jsonLdWebPage, jsonLdBreadcrumb];
---

<BaseLayout
  title="血液型診断【A・B・O・AB型 性格傾向】｜診断ナビ"
  description="A型・B型・O型・AB型の性格傾向・強み・仕事・恋愛スタイルを自己理解のために解説。古川竹二（1927）・能見正比古（1971）の研究ベース。相性診断への導線あり。"
  canonical={PAGE_URL}
  jsonLd={jsonLdAll}
  ogType="website"
  ogImage="/og/blood-type.png"
  publishDate="2026-06-07"
  lastUpdated={UPDATED_AT}
  breadcrumbs={[
    { name: '診断一覧', url: '/diagnosis/' },
    { name: '血液型診断', url: '/diagnosis/blood-type/' },
  ]}
>

  {/* ========== ヒーロー ========== */}
  <section class="bt-hub-hero" aria-labelledby="bt-hub-h1">
    <Container>
      <div class="bt-hub-hero-inner">
        <div class="bt-hub-badge">古川竹二（1927）・能見正比古（1971）研究 + 日本心理学会見解</div>
        <h1 id="bt-hub-h1" class="bt-hub-h1">
          血液型診断<br />
          <span class="bt-hub-meta">あなたの血液型から見る性格傾向</span>
        </h1>
        <p class="bt-hub-catch">
          A型・B型・O型・AB型——それぞれの特徴・強み・仕事・恋愛スタイルを自己理解のために解説します。<br />
          自分のタイプを知ってから、相性活用へ進みましょう。
        </p>
        <div class="bt-hub-cta-group">
          <a href="/diagnosis/blood-type/a/" class="bt-hub-cta-btn bt-hub-cta-btn--primary">
            A型の特徴を見る
          </a>
          <a href="/diagnosis/blood-compat/" class="bt-hub-cta-btn bt-hub-cta-btn--secondary">
            相性診断へ（派生）
          </a>
        </div>
        <div class="bt-hub-disclaimer" role="note">
          日本の文化的分類です。日本心理学会（2014）は「血液型と性格の科学的相関は認められない」と公式見解を示しています。
          <a href="https://psych.or.jp/opinion/bl-personality/" target="_blank" rel="noopener noreferrer">公式見解を読む</a>
        </div>
      </div>
    </Container>
  </section>

  <Container>

    {/* ========== このページでわかること ========== */}
    <div class="bt-hub-aio" role="note" aria-label="このページでわかること">
      <p class="bt-hub-aio-title">このページでわかること</p>
      <ul class="bt-hub-aio-list">
        <li>A・B・O・AB型 各タイプの性格傾向・強み・気をつけたいこと</li>
        <li>仕事・恋愛・友人関係でのスタイルの違い</li>
        <li>血液型分類の文化的・科学的位置付けと正しい活用法</li>
        <li>自己理解の後に使う「相性診断」への導線</li>
      </ul>
    </div>

    {/* ========== 血液型診断とは（自己理解ファースト） ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-what-h2">
      <h2 id="bt-hub-what-h2" class="bt-hub-h2">血液型診断とは——自己理解のきっかけとして使う</h2>
      <div class="bt-hub-science-card">
        <p class="bt-hub-lead">
          血液型性格分類は、1927年に古川竹二が「血液型による気質の研究」として発表し、
          1971年に能見正比古が『血液型でわかる相性』を出版して広まった<strong>日本独自の文化的現象</strong>です。
        </p>
        <p class="bt-hub-lead">
          一方で、日本心理学会は2014年の
          <a href="https://psych.or.jp/opinion/bl-personality/" target="_blank" rel="noopener noreferrer">公式見解</a>で
          「血液型と性格の間に科学的に明確な統計的相関は認められない」と明言しています。
        </p>

        <div class="bt-hub-usage-grid">
          <div class="bt-hub-usage-ok">
            <strong>推奨する活用法</strong>
            <p>自己理解のヒント・人間関係の話題・会話のきっかけとして楽しむ</p>
          </div>
          <div class="bt-hub-usage-ng">
            <strong>推奨しない活用法</strong>
            <p>人の採用・評価・交際・結婚の判断基準にする / 血液型で人を決めつける</p>
          </div>
        </div>

        <div class="bt-hub-disclaimer-box" role="note" aria-label="免責事項">
          <p>
            本ページは日本の血液型性格分類文化と傾向研究を参考に整理した自己理解のための参考情報です。
            科学的に厳密な統計的相関は限定的であり（日本心理学会公式見解 2014年）、
            医学的・臨床的な診断ではありません。
          </p>
        </div>
      </div>
    </section>

    {/* ========== 4タイプカード ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-types-h2">
      <h2 id="bt-hub-types-h2" class="bt-hub-h2">4タイプの性格傾向——あなたのタイプを選んでください</h2>
      <p class="bt-hub-lead">
        各タイプをクリックすると、強み・気をつけたい傾向・仕事・恋愛・友人関係スタイルの詳細解説に進めます。
      </p>

      <div class="bt-hub-types-grid">
        {BLOOD_TYPES.map((type) => {
          const detail = typesDetail[type];
          const style = typeSummaries[type];
          return (
            <a
              href={style.href}
              class="bt-hub-type-card"
              style={`background: ${style.bg}; border-color: ${style.border};`}
              aria-label={`${typeLabels[type]}の性格傾向を見る`}
            >
              <div class="bt-hub-type-badge" style={`background: ${style.color};`}>
                {typeLabels[type]}
              </div>
              <h3 class="bt-hub-type-name" style={`color: ${style.color};`}>
                {detail.name}
              </h3>
              <p class="bt-hub-type-nickname">「{detail.nickname}」</p>
              <p class="bt-hub-type-keyword">{style.keyword}</p>
              <ul class="bt-hub-type-strengths">
                {detail.strengths.slice(0, 2).map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <span class="bt-hub-type-link" style={`color: ${style.color};`}>
                {typeLabels[type]}の詳細を見る &rarr;
              </span>
            </a>
          );
        })}
      </div>
    </section>

    {/* ========== 自己理解の次のステップ（CTAブロック） ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-next-h2">
      <h2 id="bt-hub-next-h2" class="bt-hub-h2">自己理解の次のステップ</h2>
      <p class="bt-hub-lead">
        自分のタイプを理解したら、次は仕事・恋愛・友人関係ごとの活用法や相性確認へ進みましょう。
      </p>
      <div class="bt-hub-next-grid">
        <a href="/diagnosis/blood-type/love/" class="bt-hub-next-card">
          <div class="bt-hub-next-icon" aria-hidden="true">&#x1F49B;</div>
          <h3 class="bt-hub-next-title">恋愛タイプ詳細</h3>
          <p class="bt-hub-next-desc">
            血液型×恋愛スタイルの傾向。好きになりやすい相手・すれ違いパターンを解説
          </p>
          <span class="bt-hub-next-link">恋愛タイプを見る &rarr;</span>
        </a>
        <a href="/diagnosis/blood-type/work/" class="bt-hub-next-card">
          <div class="bt-hub-next-icon" aria-hidden="true">&#x1F4BC;</div>
          <h3 class="bt-hub-next-title">仕事タイプ詳細</h3>
          <p class="bt-hub-next-desc">
            血液型×仕事スタイルの傾向。職場コミュニケーション・向いている役割を解説
          </p>
          <span class="bt-hub-next-link">仕事タイプを見る &rarr;</span>
        </a>
        <a href="/diagnosis/blood-compat/" class="bt-hub-next-card bt-hub-next-card--accent">
          <div class="bt-hub-next-icon" aria-hidden="true">&#x1F91D;</div>
          <h3 class="bt-hub-next-title">相性診断へ（派生）</h3>
          <p class="bt-hub-next-desc">
            自己理解の後は相性活用へ。A×B×O×ABの全10ペアのスコア・特徴を収録
          </p>
          <span class="bt-hub-next-link">相性診断を見る &rarr;</span>
        </a>
      </div>
    </section>

    {/* ========== 8診断統合プロファイルへの導線 ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-profile-h2">
      <h2 id="bt-hub-profile-h2" class="bt-hub-h2">血液型 + 他の7診断で「統合プロファイル」を作る</h2>
      <div class="bt-hub-profile-card">
        <p class="bt-hub-lead">
          診断ナビでは血液型だけでなく、MBTI・多重知能・DiSC・恋愛スタイルなど8診断を統合して
          「あなた全体」を多角的に把握できます。
          血液型は「日本の文化的分類のひとつ」として統合プロファイルに組み込まれます。
        </p>
        <div class="bt-hub-profile-links">
          <a href="/diagnosis/" class="bt-hub-profile-btn">
            8診断一覧を見る &rarr;
          </a>
          <a href="/diagnosis/mbti/" class="bt-hub-profile-btn bt-hub-profile-btn--sub">
            MBTI診断（心理学的根拠あり）
          </a>
        </div>
      </div>
    </section>

    {/* ========== 血液型ハラスメント警告 ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-harassment-h2">
      <h2 id="bt-hub-harassment-h2" class="bt-hub-h2">血液型ハラスメント（ブラハラ）について</h2>
      <div class="bt-hub-harassment-box" role="alert" aria-label="血液型ハラスメントの警告">
        <p class="bt-hub-harassment-lead">
          血液型ハラスメント（ブラハラ）とは、血液型を理由に不当な扱いや決めつけを行うことです。
          以下のような言動はブラハラに該当する可能性があります。
        </p>
        <ul class="bt-hub-harassment-list">
          <li>「B型だから採用しない」「AB型は変わり者」と職場や採用で差別する</li>
          <li>血液型を根拠に特定の役割や責任を押しつける</li>
          <li>「O型のくせに大雑把じゃないの？」などと人格を否定する</li>
          <li>交友関係や恋愛において血液型だけを理由として排除する</li>
        </ul>
        <p class="bt-hub-harassment-note">
          本サイトは血液型を「自己理解と対話のきっかけ」として楽しむことを推奨します。
          血液型による人物の断定・評価・排除を勧める意図は一切ありません。
        </p>
      </div>
    </section>

    {/* ========== 参考文献・学術根拠 ========== */}
    <section class="bt-hub-section" aria-labelledby="bt-hub-ref-h2">
      <h2 id="bt-hub-ref-h2" class="bt-hub-h2">参考文献・学術根拠</h2>
      <ol class="bt-hub-ref-list">
        <li class="bt-hub-ref-item">
          <cite>古川竹二（1927）「血液型による気質の研究」心理学研究 第2巻第4号</cite>
          <a href="https://www.jstage.jst.go.jp/browse/psycholres" target="_blank" rel="noopener noreferrer" class="bt-hub-ref-link">公式ページ</a>
          <p class="bt-hub-ref-note">血液型性格分類研究の嚆矢。4型の気質傾向を初めて体系的に記述。</p>
        </li>
        <li class="bt-hub-ref-item">
          <cite>能見正比古（1971）『血液型でわかる相性』青春出版社</cite>
          <p class="bt-hub-ref-note">日本で血液型性格論を一般に広めた代表的著作。</p>
        </li>
        <li class="bt-hub-ref-item">
          <cite>Sakamoto A, Yamazaki K（2004）International Journal of Psychology, 39(4)</cite>
          <a href="https://doi.org/10.1080/00207590344000248" target="_blank" rel="noopener noreferrer" class="bt-hub-ref-link">DOI</a>
          <p class="bt-hub-ref-note">血液型ステレオタイプは自己成就予言で説明できると指摘。相関は限定的。</p>
        </li>
        <li class="bt-hub-ref-item">
          <cite>日本心理学会（2014）「血液型と性格の関連についての公式見解」</cite>
          <a href="https://psych.or.jp/opinion/bl-personality/" target="_blank" rel="noopener noreferrer" class="bt-hub-ref-link">公式ページ</a>
          <p class="bt-hub-ref-note">科学的に明確な統計的相関は認められないとする公式見解。確認日: 2026-06-07</p>
        </li>
        <li class="bt-hub-ref-item">
          <cite>縄田健悟（2014）「血液型と性格は無関係」心理学研究 85(2)</cite>
          <a href="https://doi.org/10.4992/jjpsy.85.13E0025" target="_blank" rel="noopener noreferrer" class="bt-hub-ref-link">DOI</a>
          <p class="bt-hub-ref-note">日米1万件超のデータ分析。血液型が性格を説明できる割合は0.3%未満。</p>
        </li>
      </ol>
      <p class="bt-hub-ref-updated">最終確認日: <time datetime={UPDATED_AT}>{UPDATED_AT}</time>（診断ナビ編集部）</p>
    </section>

  </Container>
</BaseLayout>

<style>
  /* ========== CSS変数 ========== */
  :root {
    --bt-hub-primary: #c0392b;
    --bt-hub-text: var(--sn-text, #1f2937);
    --bt-hub-muted: var(--sn-muted, #6b7280);
    --bt-hub-border: var(--sn-border, #e5e7eb);
    --bt-hub-surface: var(--sn-surface, #f9fafb);
    --bt-hub-radius: 12px;
  }

  /* ========== ヒーロー ========== */
  .bt-hub-hero {
    background: linear-gradient(135deg, #fff5f5 0%, #fef2f2 60%, #fff0f0 100%);
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--bt-hub-border);
  }
  .bt-hub-hero-inner {
    text-align: center;
  }
  .bt-hub-badge {
    display: inline-block;
    background: rgba(192, 57, 43, 0.1);
    color: var(--bt-hub-primary);
    border: 1px solid rgba(192, 57, 43, 0.3);
    border-radius: 999px;
    padding: 0.3rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .bt-hub-h1 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--bt-hub-text);
    margin: 0 0 0.8rem;
  }
  .bt-hub-meta {
    display: block;
    font-size: clamp(0.95rem, 2.5vw, 1.2rem);
    font-weight: 600;
    color: var(--bt-hub-primary);
  }
  .bt-hub-catch {
    font-size: 1rem;
    color: var(--bt-hub-muted);
    line-height: 1.8;
    margin: 0 0 1.2rem;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: 1.2rem;
  }
  .bt-hub-cta-group {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .bt-hub-cta-btn {
    padding: 0.8rem 1.6rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.15s;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .bt-hub-cta-btn:hover { opacity: 0.85; }
  .bt-hub-cta-btn--primary {
    background: var(--bt-hub-primary);
    color: #fff;
    box-shadow: 0 8px 18px rgba(192, 57, 43, 0.3);
  }
  .bt-hub-cta-btn--secondary {
    background: #fff;
    color: var(--bt-hub-primary);
    border: 2px solid var(--bt-hub-primary);
  }
  .bt-hub-disclaimer {
    font-size: 0.78rem;
    color: var(--bt-hub-muted);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .bt-hub-disclaimer a {
    color: var(--bt-hub-primary);
  }

  /* ========== 共通 ========== */
  .bt-hub-section {
    margin: 3rem 0;
  }
  .bt-hub-h2 {
    font-size: clamp(1.15rem, 3vw, 1.45rem);
    font-weight: 800;
    color: var(--bt-hub-text);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--bt-hub-primary);
  }
  .bt-hub-lead {
    font-size: 0.97rem;
    line-height: 1.8;
    color: var(--bt-hub-text);
