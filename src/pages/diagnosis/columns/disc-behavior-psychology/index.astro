import Container from '../../../../components/Container.astro';
import TldrBlock from '../../../../components/TldrBlock.astro';
import ReferenceList from '../../../../components/ReferenceList.astro';
import ScienceNote from '../../../../components/ScienceNote.astro';

const SITE_URL = 'https://shindan-navi.jp';
const PAGE_URL = `${SITE_URL}/diagnosis/columns/disc-behavior-psychology/`;
const UPDATED_AT = '2026-06-10';

const title = 'DiSC理論と行動心理学：Marston博士の誕生から現代の科学的位置づけまで';
const description =
  'DiSC理論の行動心理学的根拠を解説。Marston（1928）が提唱したDISC理論の誕生背景、Clarke・Geier・Wileyへの発展、現代心理学での評価・限界まで学術根拠付きで網羅。2026-06-10確認。';

const jsonLdArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${PAGE_URL}#article`,
  headline: title,
  description: description,
  url: PAGE_URL,
  datePublished: '2026-06-10',
  dateModified: UPDATED_AT,
  inLanguage: 'ja',
  author: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: '診断ナビ',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: '診断ナビ',
    url: SITE_URL,
  },
};

const faqs = [
  {
    question: 'DiSC理論はどこから生まれたのですか？',
    answer:
      'DiSC理論は心理学者 William Moulton Marston が1928年の著書「Emotions of Normal People」（Routledge）で初めて体系化しました。Marstonは「感情が行動にどう影響するか」を研究し、環境認識（有利/不利）と自己認識（強/弱）の2軸から4つの行動パターン（Dominance・Influence・Submission・Compliance）を導きました。現代のDiSCはWiley社がこの理論を整備したものです（https://www.discprofile.com/what-is-disc/history-of-disc、2026-06-10確認）。',
  },
  {
    question: 'Marstonはライオン作者と同一人物ですか？',
    answer:
      'はい、William Moulton Marston（1893-1947）はDiSC理論の提唱者であると同時に、DCコミックスの「ワンダーウーマン」の原作者でもあります。また血圧に基づくポリグラフ（嘘発見器）の研究でも知られています。心理学・法学・大衆文化の三領域を横断した異才の人物です。',
  },
  {
    question: 'DiSC理論は科学的に有効ですか？',
    answer:
      '行動スタイルの分類ツールとして職場コミュニケーションの改善に広く活用されていますが、臨床心理学的な診断ツールではありません。Wiley社の研究では、DiSCは信頼性・構成概念妥当性が確認されています（https://www.discprofile.com/what-is-disc/reliability-and-validity、2026-06-10確認）。ただし科学的検証は継続中であり、自己報告式ツールとしての限界（回答バイアス・状況依存性）も認識した上で活用することが推奨されます。',
  },
  {
    question: 'DiSCとMBTI・ビッグファイブの違いは？',
    answer:
      'DiSCは「職場での行動スタイル（コミュニケーション・意思決定・課題対応の傾向）」を測ります。MBTIは「性格の認知スタイル（4軸・16タイプ）」を測り、対人関係・仕事の意思決定パターン全般を対象にします。ビッグファイブ（五因子モデル）は「開放性・誠実性・外向性・協調性・神経症傾向」という5つの特性次元を測り、現代心理学で最も広く研究されている性格モデルです。いずれも異なる切り口の自己理解ツールであり、目的に応じて組み合わせることで自己理解の精度が高まります。',
  },
  {
    question: 'DiSCタイプは生まれつき決まっているのですか？',
    answer:
      'Marston（1928）の理論では行動スタイルは「環境との相互作用の中で形成される」とされており、生まれつき固定されるものではありません。Wiley社の研究でも、DiSCスタイルは成長・経験・役割変化によって変化し得ることが示されています。タイプは固定的なラベルではなく、「現在の傾向」として参考にしてください（https://www.discprofile.com/what-is-disc/overview、2026-06-10確認）。',
  },
];

const jsonLdFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${PAGE_URL}#faq`,
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const jsonLdBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: '診断一覧', item: `${SITE_URL}/diagnosis/` },
    { '@type': 'ListItem', position: 3, name: 'DiSCコラム', item: `${SITE_URL}/diagnosis/columns/` },
    { '@type': 'ListItem', position: 4, name: 'DiSC理論と行動心理学', item: PAGE_URL },
