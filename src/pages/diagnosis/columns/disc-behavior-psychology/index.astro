};

const jsonLdAll = [jsonLdArticle, jsonLdFAQ, jsonLdBreadcrumb];

const historyTimeline = [
  {
    year: '1928年',
    person: 'William Moulton Marston',
    event: '著書「Emotions of Normal People」でDISC理論の原型を発表',
    detail: '環境認識（有利/不利）×自己認識（強/弱）の2軸から4種の行動パターンを提唱。Dominance・Influence・Submission・Complianceを定義。',
    url: 'https://archive.org/details/emotionsofnormal00mars',
  },
  {
    year: '1956年',
    person: 'Walter Vernon Clarke',
    event: 'Activity Vector Analysis（AVA）を開発。Marstonの理論を職場適用に転換',
    detail: 'Marstonの理論を職場での行動スタイル測定ツールに実用化。DiSCが職場コミュニケーションツールとして機能し始める契機。',
    url: 'https://www.discprofile.com/what-is-disc/history-of-disc',
  },
  {
    year: '1970年代',
    person: 'John Geier',
    event: 'Personal Profile System（Performax）を開発',
    detail: '心理測定としての信頼性を高め、DiSCの普及を加速。4タイプの現代的な呼称（D/i/S/C）の確立に貢献。',
    url: 'https://www.discprofile.com/what-is-disc/history-of-disc',
  },
  {
    year: '1984年〜',
    person: 'Wiley（旧Inscape Publishing）',
    event: 'Everything DiSC® ブランドとして整備・グローバル展開',
    detail: '適応型テスト・詳細レポート・認定ファシリテータープログラムを整備。現在、世界75か国・年間100万人以上の組織研修で活用。',
    url: 'https://www.everythingdisc.com/',
  },
];
