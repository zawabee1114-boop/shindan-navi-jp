              <th scope="col">ツール</th>
              <th scope="col">問題数</th>
              <th scope="col">所要時間</th>
              <th scope="col">登録</th>
              <th scope="col">結果</th>
              <th scope="col">費用</th>
            </tr>
          </thead>
          <tbody>
            {toolComparison.map((t) => (
              <tr class={t.highlight ? 'col-table-highlight' : ''}>
                <th scope="row">
                  {t.url && t.url.startsWith('/') ? (
                    <a href={t.url} class="col-table-link">{t.name}</a>
                  ) : t.url ? (
                    <a href={t.url} target="_blank" rel="noopener noreferrer" class="col-table-link">{t.name}</a>
                  ) : (
                    t.name
                  )}
                  {t.highlight && <span class="col-badge-recommend">おすすめ</span>}
